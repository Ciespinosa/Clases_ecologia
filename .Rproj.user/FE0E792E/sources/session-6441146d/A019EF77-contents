/* ============================================
   ESTILO GENERAL
   ============================================ */

.reveal {
  font-size: 26px;
  line-height: 1.4;
}

/* ============================================
   ESPACIADO DE TÍTULOS Y CONTENIDO
   ============================================ */

/* Más espacio debajo del título de la diapositiva */
.reveal h2 {
  color: #2e7d32;
  font-size: 1.5em;
  margin-bottom: 1.2em;
  padding-bottom: 0.4em;
  border-bottom: 2px solid #c8e6c9;
}

/* Títulos de sección (Partes) */
.reveal h1 {
  color: #2e7d32;
  font-size: 2.2em;
  margin-bottom: 1.5em;
}

/* Subtítulos dentro del contenido */
.reveal h3 {
  color: #388e3c;
  font-size: 1.2em;
  margin-top: 1.2em;
  margin-bottom: 0.8em;
}

/* Párrafos con más aire */
.reveal p {
  margin-bottom: 0.8em;
}

/* ============================================
   LISTAS CON MÁS ESPACIO
   ============================================ */

.reveal ul,
.reveal ol {
  margin-top: 0.6em;
  margin-bottom: 0.8em;
}

.reveal ul li,
.reveal ol li {
  margin-bottom: 0.7em;
  line-height: 1.5;
}

/* Listas anidadas */
.reveal ul ul li,
.reveal ol ol li {
  margin-bottom: 0.4em;
  font-size: 0.95em;
}

/* ============================================
   DEFINICIONES DESTACADAS (blockquote)
   ============================================ */

.reveal blockquote {
  background: #e8f5e9;
  border-left: 5px solid #2e7d32;
  padding: 1.2rem 1.8rem;
  border-radius: 6px;
  font-style: normal;
  color: #1b5e20;
  width: 92%;
  box-shadow: none;
  font-size: 1.05em;
  margin: 1.2em auto;
}

.reveal blockquote p {
  margin-bottom: 0;
}

/* ============================================
   TABLAS CON MÁS ESPACIO
   ============================================ */

.reveal table {
  font-size: 0.85em;
  margin: 1.5em auto;
  border-collapse: collapse;
}

.reveal table th {
  background: #2e7d32;
  color: white;
  padding: 0.7rem 1.2rem;
  font-weight: bold;
}

.reveal table td {
  padding: 0.6rem 1.2rem;
  border-bottom: 1px solid #c8e6c9;
}

/* ============================================
   FRAGMENTOS
   ============================================ */

.reveal .fragment {
  color: #1b5e20;
  font-weight: bold;
  margin-top: 1.2em;
}

/* ============================================
   NOTAS DEL ORADOR
   ============================================ */

.reveal .notes {
  font-size: 1em;
}

/* ============================================
   CÓDIGO
   ============================================ */

.reveal code {
  background: #f1f8e9;
  color: #1b5e20;
  padding: 0.15rem 0.5rem;
  border-radius: 3px;
}

/* ============================================
   FIGURAS
   ============================================ */

.reveal img,
.reveal .cell-output-display img {
  max-height: 500px;
  margin: 1em auto;
}

.reveal .cell-output-display {
  margin: 1.5em 0;
}

/* ============================================
   COLUMNAS
   ============================================ */

.reveal .columns {
  margin-top: 1.2em;
}

.reveal .column {
  padding: 0 1em;
}