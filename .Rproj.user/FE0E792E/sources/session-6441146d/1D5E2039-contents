/* Banner principal */
.hero-banner {
  background: linear-gradient(135deg, #2e7d32 0%, #66bb6a 100%);
  color: white;
  padding: 3rem 2rem;
  border-radius: 12px;
  margin-bottom: 2rem;
  text-align: center;
}

.hero-banner h1 {
  color: white;
  font-size: 2.3rem;
  margin-bottom: 0.5rem;
}

.hero-banner p {
  font-size: 1.05rem;
  opacity: 0.95;
  margin-bottom: 0;
}

/* Tarjetas de bloques */
.g-col-6 {
  background: #f8f9fa;
  padding: 1.5rem;
  border-radius: 10px;
  border-left: 4px solid #2e7d32;
  margin-bottom: 1rem;
}

.g-col-6 h3 {
  margin-top: 0;
  color: #2e7d32;
}

.g-col-6 ul {
  padding-left: 1.2rem;
  margin-bottom: 0;
}

.g-col-6 li {
  margin-bottom: 0.4rem;
}

/* Callout de contacto */
.callout-note {
  background: #e8f5e9;
  border-left: 4px solid #2e7d32;
  padding: 1rem 1.5rem;
  border-radius: 8px;
}