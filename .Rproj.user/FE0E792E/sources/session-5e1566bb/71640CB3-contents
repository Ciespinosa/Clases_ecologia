| Pequeña | ? | ? | ? | ? | ? |
| Mediana | ? | ? | ? | ? | ? |
| Grande | ? | ? | ? | ? | ? |
| Muy grande | ? | ? | ? | ? | ? |

::: {.callout-tip}
