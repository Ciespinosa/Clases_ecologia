  <assessment ident="parcial1" title="Parcial 1 — Unidad 1: Poblaciones">
    <section ident="section1" title="Sección A — Opción múltiple">

      <!-- Pregunta A1 -->
      <item ident="A1" title="A1. Propiedades emergentes">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">¿Por qué la densidad es una propiedad emergente de las poblaciones?</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="A1_a">
                <material><mattext texttype="text/plain">Porque se mide en individuos por área.</mattext></material>
              </response_label>
              <response_label ident="A1_b">
                <material><mattext texttype="text/plain">Porque solo existe cuando hay un conjunto de individuos en un espacio, no en un individuo aislado.</mattext></material>
              </response_label>
              <response_label ident="A1_c">
                <material><mattext texttype="text/plain">Porque depende de la edad de los individuos.</mattext></material>
              </response_label>
              <response_label ident="A1_d">
                <material><mattext texttype="text/plain">Porque es una propiedad primaria de la población.</mattext></material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">A1_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Pregunta A2 -->
      <item ident="A2" title="A2. Delimitación de poblaciones">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">En la hoya de Loja hay tres fragmentos de bosque con Cedrela montana. ¿Qué información es más importante para decidir si son una o tres poblaciones?</mattext>
          </material>
          <response_lid ident="response2" rcardinality="Single">
            <render_choice>
              <response_label ident="A2_a">
                <material><mattext texttype="text/plain">La distancia geográfica entre los fragmentos.</mattext></material>
              </response_label>
              <response_label ident="A2_b">
                <material><mattext texttype="text/plain">El número de árboles en cada fragmento.</mattext></material>
              </response_label>
              <response_label ident="A2_c">
                <material><mattext texttype="text/plain">La existencia de flujo génico entre los fragmentos.</mattext></material>
              </response_label>
              <response_label ident="A2_d">
                <material><mattext texttype="text/plain">El tamaño de los fragmentos.</mattext></material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response2">A2_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Pregunta A3 -->
      <item ident="A3" title="A3. Fitness absoluto vs. relativo">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">El árbol A deja 200 descendientes viables y el árbol B deja 100. ¿Cuál afirmación es correcta?</mattext>
          </material>
          <response_lid ident="response3" rcardinality="Single">
            <render_choice>
              <response_label ident="A3_a">
                <material><mattext texttype="text/plain">El árbol A tiene mayor fitness absoluto y mayor fitness relativo.</mattext></material>
              </response_label>
              <response_label ident="A3_b">
                <material><mattext texttype="text/plain">El árbol A tiene mayor fitness absoluto, pero no necesariamente mayor fitness relativo a lo largo de toda su vida.</mattext></material>
              </response_label>
              <response_label ident="A3_c">
                <material><mattext texttype="text/plain">El árbol B tiene mayor fitness absoluto.</mattext></material>
              </response_label>
              <response_label ident="A3_d">
                <material><mattext texttype="text/plain">Ambos tienen el mismo fitness relativo.</mattext></material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response3">A3_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

