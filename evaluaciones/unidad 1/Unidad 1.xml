      <!-- Pregunta A10 -->
      <item ident="A10" title="A10. Demografía y conservación">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">¿Por qué el valor reproductivo es importante para la conservación?</mattext>
          </material>
          <response_lid ident="response10" rcardinality="Single">
            <render_choice>
              <response_label ident="A10_a">
                <material><mattext texttype="text/plain">Porque todos los individuos contribuyen igual a la siguiente generación.</mattext></material>
              </response_label>
              <response_label ident="A10_b">
                <material><mattext texttype="text/plain">Porque los individuos jóvenes con alta probabilidad de supervivencia futura contribuyen más a la siguiente generación.</mattext></material>
              </response_label>
              <response_label ident="A10_c">
                <material><mattext texttype="text/plain">Porque los individuos viejos siempre tienen mayor valor reproductivo.</mattext></material>
              </response_label>
              <response_label ident="A10_d">
                <material><mattext texttype="text/plain">Porque el valor reproductivo no cambia con la edad.</mattext></material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
