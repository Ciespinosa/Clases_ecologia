              </response_label>
              <response_label ident="A4_b">
                <material><mattext texttype="text/plain">Reproducción temprana vs. tardía.</mattext></material>
              </response_label>
              <response_label ident="A4_c">
                <material><mattext texttype="text/plain">Reproducción vs. supervivencia.</mattext></material>
