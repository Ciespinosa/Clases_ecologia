              <response_label ident="A5_b">
                <material><mattext texttype="text/plain">El esfuerzo reproductivo.</mattext></material>
              </response_label>
              <response_label ident="A5_c">
                <material><mattext texttype="text/plain">La probabilidad de supervivencia futura.</mattext></material>
              </response_label>
              <response_label ident="A5_d">
                <material><mattext texttype="text/plain">El fitness absoluto.</mattext></material>
              </response_label>
            </render_choice>
